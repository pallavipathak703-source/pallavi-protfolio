<<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Pallavi Portfolio</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

<!-- 🔥 Loader -->
<div id="loader">Loading...</div>

<!-- 🌌 3D Background -->
<canvas id="bg"></canvas>

<!-- 💎 Main Content -->
<div class="content">

  <!-- 👩‍💻 HERO -->
  <section class="hero">
    <h1>Pallavi 👋</h1>
    <p>Frontend Developer | DSA Learner</p>
  </section>

  <!-- 🛠 SKILLS -->
  <section class="skills">
    <h2>My Skills</h2>

    <div class="skills-container">
      <div class="skill-card">C</div>
      <div class="skill-card">C++</div>
      <div class="skill-card">Python</div>
      <div class="skill-card">JavaScript</div>

      <div class="skill-card">HTML</div>
      <div class="skill-card">CSS</div>
      <div class="skill-card">Responsive Design</div>

      <div class="skill-card">DSA</div>
      <div class="skill-card">Arrays</div>
      <div class="skill-card">Stacks</div>
      <div class="skill-card">Queues</div>
      <div class="skill-card">Heaps</div>

      <div class="skill-card">VS Code</div>
      <div class="skill-card">GitHub</div>
    </div>
  </section>

  <!-- 💼 PROJECTS -->
  <section class="projects">
    <h2>My Projects</h2>

    <div class="projects-container">

      <div class="card" onclick="openProject('portfolio')">
        <h3>3D Portfolio</h3>
        <p>Interactive 3D personal portfolio</p>
      </div>

      <div class="card" onclick="openProject('todo')">
        <h3>ToDo App</h3>
        <p>Task manager with local storage</p>
      </div>

      <div class="card" onclick="openProject('calculator')">
        <h3>Calculator</h3>
        <p>Basic arithmetic calculator</p>
      </div>

      <div class="card" onclick="openProject('landing')">
        <h3>Landing Page</h3>
        <p>Responsive UI design</p>
      </div>

    </div>
  </section>

  <!-- 📞 CONTACT -->
  <section class="contact">
    <h2>Contact Me</h2>
    <p>Email: pallavipathak703@gmail.com</p>
    <p>Phone: 7561991674</p>
  </section>

</div>

<!-- Three.js -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Poppins&display=swap" rel="stylesheet">
<!-- JS -->
<script src="script.js"></script>

</body>
</html>
// Scene
const scene = new THREE.Scene();

// Camera
const camera = new THREE.PerspectiveCamera(
  75,
  window.innerWidth / window.innerHeight,
  0.1,
  1000
);
camera.position.z = 5;

// Renderer
const renderer = new THREE.WebGLRenderer({
  canvas: document.querySelector('#bg'),
  antialias: true,
});
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(window.devicePixelRatio);

// 🌌 STARS (better version)
const stars = [];

function addStar() {
  const geometry = new THREE.SphereGeometry(0.08, 24, 24);
  const material = new THREE.MeshBasicMaterial({ color: 0xffffff });
  const star = new THREE.Mesh(geometry, material);

  const [x, y, z] = Array(3)
    .fill()
    .map(() => THREE.MathUtils.randFloatSpread(100));

  star.position.set(x, y, z);
  scene.add(star);
  stars.push(star);
}

Array(500).fill().forEach(addStar);

// 🎥 SMOOTH MOUSE FOLLOW (lerp)
let mouseX = 0;
let mouseY = 0;

document.addEventListener("mousemove", (e) => {
  mouseX = (e.clientX / window.innerWidth - 0.5) * 2;
  mouseY = (e.clientY / window.innerHeight - 0.5) * 2;
});

// 📜 SCROLL EFFECT
document.body.onscroll = () => {
  const t = document.body.getBoundingClientRect().top;
  camera.position.z = 5 + t * -0.01;
};

// ✨ ANIMATION LOOP
function animate() {
  requestAnimationFrame(animate);

  // Smooth camera movement
  camera.position.x += (mouseX * 1.5 - camera.position.x) * 0.05;
  camera.position.y += (-mouseY * 1.5 - camera.position.y) * 0.05;

  // Stars subtle movement
  stars.forEach(star => {
    star.position.z += 0.05;
    if (star.position.z > 5) star.position.z = -50;
  });

  renderer.render(scene, camera);
}

animate();

// 🔗 PROJECT LINKS
// 🔗 PROJECT LINKS
function openProject(type) {
  if (type === 'portfolio') {
    window.open('[statuesque-gelato-16fda2.netlify.app](https://statuesque-gelato-16fda2.netlify.app)');
  }
  if (type === 'todo') {
    window.open('https://pallavipathak703-source.github.io/Todo-app/');
  }
  if (type === 'calculator') {
    window.open('https://pallavipathak703-source.github.io/calculator-app1/');
  }                                                         
  if (type === 'landing') {
    window.open('https://pallavipathak703-source.github.io/landingpage/');
  }
}


// ⏳ LOADER REMOVE
window.onload = () => {
  document.getElementById("loader").style.display = "none";
};

// 📱 RESPONSIVE
window.addEventListener("resize", () => {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});
/* RESET */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Poppins', sans-serif;
  overflow-x: hidden;
  background: black;
  color: white;
}

/* 🔥 LOADER */
#loader {
  position: fixed;
  width: 100%;
  height: 100%;
  background: black;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 30px;
  z-index: 100;
  animation: fadeOut 2s ease forwards;
  animation-delay: 1.5s;
}

@keyframes fadeOut {
  to {
    opacity: 0;
    visibility: hidden;
  }
}

/* 🌌 CANVAS */
canvas {
  position: fixed;
  top: 0;
  left: 0;
}

/* 💎 MAIN CONTENT */
.content {
  position: relative;
  z-index: 1;
  text-align: center;
}

/* 👩‍💻 HERO */
.hero {
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.hero h1 {
  font-size: 60px;
  background: linear-gradient(90deg, cyan, white);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero p {
  margin-top: 10px;
  font-size: 20px;
  opacity: 0.8;
}

/* 🛠 SKILLS */
.skills {
  padding: 100px 20px;
}

.skills h2 {
  font-size: 40px;
  margin-bottom: 40px;
}

/* Skills Grid */
.skills-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 15px;
}

/* Skill Card */
.skill-card {
  padding: 12px 20px;
  border-radius: 25px;
  background: rgba(255,255,255,0.1);
  backdrop-filter: blur(10px);
  transition: 0.3s;
  cursor: pointer;
}

/* Hover Glow */
.skill-card:hover {
  transform: scale(1.2);
  background: rgba(0,255,255,0.3);
  box-shadow: 0 0 15px cyan;
}

/* 💼 PROJECTS */
.projects {
  padding: 100px 20px;
}

.projects h2 {
  font-size: 40px;
  margin-bottom: 40px;
}

/* Project Grid */
.projects-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20px;
}

/* Cards */
.card {
  width: 220px;
  padding: 20px;
  border-radius: 15px;
  background: rgba(255,255,255,0.1);
  backdrop-filter: blur(15px);
  transition: 0.3s;
  cursor: pointer;
}

/* Card Hover */
.card:hover {
  transform: translateY(-10px) scale(1.05);
  background: rgba(0,255,255,0.2);
  box-shadow: 0 0 20px cyan;
}

.card h3 {
  margin-bottom: 10px;
}

.card p {
  font-size: 14px;
  opacity: 0.8;
}

/* 📞 CONTACT */
.contact {
  padding: 100px 20px;
}

.contact h2 {
  font-size: 35px;
  margin-bottom: 20px;
}

.contact p {
  margin: 5px 0;
  opacity: 0.8;
}

/* 📱 RESPONSIVE */
@media (max-width: 768px) {
  .hero h1 {
    font-size: 40px;
  }

  .projects-container {
    flex-direction: column;
    align-items: center;
  }
}
